DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
# Tailscale development hostname (Django must be reachable through Tailscale Funnel for external payment providers).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,100.109.224.0,opondo-thinkpad-t14-gen-1.tail34bca9.ts.net
CORS_ALLOWED_ORIGINS=http://localhost:5175,http://127.0.0.1:5175,http://100.109.224.0:5175,https://localhost
CSRF_TRUSTED_ORIGINS=http://localhost:5175,http://127.0.0.1:5175,http://100.109.224.0:5175,https://localhost

# Independent PostgreSQL database. These values are NOT Supabase credentials.
DB_NAME=sakakrib
DB_USER=sakakrib
DB_PASSWORD=replace-me
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=prefer
DB_CONN_MAX_AGE=60

# Shared Redis for Channels/realtime and Celery task queue
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_TIMEZONE=Africa/Nairobi

# Direct SMTP email delivery. No Resend or other email API is required.
# Use the SMTP credentials supplied by your email provider/app.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=replace-with-your-email-app-password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=20
EMAIL_FROM=your-email@example.com
DEFAULT_FROM_EMAIL=your-email@example.com
ADMIN_EMAIL=admin@example.com

# Firebase Cloud Messaging (FCM) server credentials; never commit the real service-account JSON.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_FILE=/secure/path/to/firebase-service-account.json
# Alternatively, provide the full service-account JSON as one escaped environment value:
# FIREBASE_SERVICE_ACCOUNT_JSON={...}

# Google Identity Services (Web OAuth client)
GOOGLE_CLIENT_ID=replace-with-google-web-client-id.apps.googleusercontent.com

# Sign in with Apple. Keep the .p8 private key on the Django server; never expose it to Vite.
# APPLE_CLIENT_ID is the Apple Services ID used for web/authorization-code exchange.
APPLE_CLIENT_ID=
APPLE_BUNDLE_ID=com.sakakrib.app
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=/app/Perm/AuthKey_XXXXXXXXXX.p8
APPLE_REDIRECT_URI=https://your-verified-domain.example/api/accounts/apple/callback/

# Gemini listing caption generation (optional; deterministic fallback is used when absent/unavailable)
GEMINI_API_KEY=replace-me

# Private chat/listing media storage
DJANGO_MEDIA_ROOT=/absolute/path/to/media

# Django session/cookie settings (Django sessions are not the application auth mechanism)
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SAMESITE=None
CSRF_COOKIE_SECURE=true

# JWT authentication. Access JWT is HttpOnly and lasts 5 minutes; refresh JWT lasts 7 days.
JWT_ACCESS_LIFETIME_SECONDS=300
JWT_REFRESH_LIFETIME_SECONDS=604800
JWT_ACCESS_COOKIE=sakakrib_access
JWT_REFRESH_COOKIE=sakakrib_refresh
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax

# Listing entitlement business rules
LISTING_FREE_LIMIT=3
INDIVIDUAL_LISTING_PRICE_KES=1000

# M-Pesa STK Push
MPESA_CONSUMER_KEY=replace-me
MPESA_CONSUMER_SECRET=replace-me
MPESA_SHORTCODE=replace-me
MPESA_PASSKEY=replace-me
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_STK_URL=https://sandbox.safaricom.co.ke/mpesa/stkpush/v1/processrequest

# All M-Pesa callback URLs are derived from SAKAKRIB_PUBLIC_BASE_URL.

# M-Pesa mover payouts (Daraja B2C / Send Money)
# SecurityCredential must be generated using Safaricom's B2C certificate and your initiator password.
MPESA_PAYOUT_INITIATOR_NAME=replace-me
MPESA_PAYOUT_SECURITY_CREDENTIAL=replace-me
MPESA_PAYOUT_COMMAND_ID=BusinessPayment

# Internal SakaKrib secret for non-Safaricom/internal payout callback clients. This is NOT a Safaricom credential.
MPESA_PAYOUT_CALLBACK_SECRET=replace-with-random-secret

# PayPal
PAYPAL_CLIENT_ID=replace-me
PAYPAL_CLIENT_SECRET=replace-me
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=replace-me
PAYPAL_LISTING_WEBHOOK_ID=replace-me

# SINGLE SOURCE OF TRUTH for public URLs across email, notifications, media,
# payment callbacks and app/web deep links. Change only this value for production.
# Android App Links open the installed APK when the host is verified; otherwise
# the same /app/... URL falls back to the web app on this origin.
SAKAKRIB_PUBLIC_BASE_URL=https://opondo-thinkpad-t14-gen-1.tail34bca9.ts.net

# Browser redirects only. They never determine payment success.
# Optional explicit HTTPS App Links / Universal Links for native PayPal returns.
# If Android URLs are blank, Django derives them from SAKAKRIB_PUBLIC_BASE_URL.
# The Android host must serve /.well-known/assetlinks.json with the release APK SHA-256 fingerprint.
SAKAKRIB_ANDROID_PAYPAL_RETURN_URL=
SAKAKRIB_ANDROID_PAYPAL_CANCEL_URL=
SAKAKRIB_IOS_PAYPAL_RETURN_URL=
SAKAKRIB_IOS_PAYPAL_CANCEL_URL=
# SHA-256 fingerprint(s) of the certificate signing the Android APK; comma-separated.
ANDROID_APP_SHA256_CERT_FINGERPRINTS=
PAYPAL_SUBSCRIPTION_RETURN_URL_LOCAL=http://localhost:5175/paypal/subscription/return
PAYPAL_SUBSCRIPTION_CANCEL_URL_LOCAL=http://localhost:5175/paypal/subscription/cancel
PAYPAL_SUBSCRIPTION_RETURN_URL_NETWORK=http://100.109.224.0:5175/paypal/subscription/return
PAYPAL_SUBSCRIPTION_CANCEL_URL_NETWORK=http://100.109.224.0:5175/paypal/subscription/cancel
# Set mode to PUBLIC to use the HTTPS return/cancel URLs below.
PAYPAL_SUBSCRIPTION_RETURN_URL_MODE=LOCAL
PAYPAL_SUBSCRIPTION_RETURN_URL=${SAKAKRIB_PUBLIC_BASE_URL}/paypal/subscription/return
PAYPAL_SUBSCRIPTION_CANCEL_URL=${SAKAKRIB_PUBLIC_BASE_URL}/paypal/subscription/cancel

# PayPal subscription webhook (canonical): /api/subscriptions/paypal/webhook/
# Legacy-compatible alias: /api/subscriptions/callbacks/paypal/
# PayPal individual listing payment webhook: /api/payments/callbacks/paypal/listing/
# Both webhook URLs must be publicly reachable over HTTPS and registered in the PayPal REST App.
# Their webhook IDs are stored separately in PAYPAL_WEBHOOK_ID and PAYPAL_LISTING_WEBHOOK_ID.