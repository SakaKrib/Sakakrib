DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,100.109.224.0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://100.109.224.0:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://100.109.224.0:5173

# Independent PostgreSQL database. These values are NOT Supabase credentials.
DB_NAME=sakakrib
DB_USER=sakakrib
DB_PASSWORD=replace-me
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=prefer
DB_CONN_MAX_AGE=60

# Shared Redis for Channels/realtime and Celery task queue
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_TIMEZONE=Africa/Nairobi

# Direct SMTP email delivery. No Resend or other email API is required.
# Use the SMTP credentials supplied by your email provider/app.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=replace-with-your-email-app-password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=20
EMAIL_FROM=your-email@example.com
DEFAULT_FROM_EMAIL=your-email@example.com
ADMIN_EMAIL=admin@example.com

# Google Identity Services (Web OAuth client)
GOOGLE_CLIENT_ID=replace-with-google-web-client-id.apps.googleusercontent.com

# Gemini listing caption generation (optional; deterministic fallback is used when absent/unavailable)
GEMINI_API_KEY=replace-me

# Private chat/listing media storage
DJANGO_MEDIA_ROOT=/absolute/path/to/media
CHAT_ATTACHMENT_BASE_URL=https://your-api-domain.example

# Django session/cookie settings (Django sessions are not the application auth mechanism)
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SECURE=false

# JWT authentication. Access JWT is HttpOnly and lasts 5 minutes; refresh JWT lasts 7 days.
JWT_ACCESS_LIFETIME_SECONDS=300
JWT_REFRESH_LIFETIME_SECONDS=604800
JWT_ACCESS_COOKIE=sakakrib_access
JWT_REFRESH_COOKIE=sakakrib_refresh
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax

# Listing entitlement business rules
LISTING_FREE_LIMIT=3
INDIVIDUAL_LISTING_PRICE_KES=1000

# M-Pesa
MPESA_CONSUMER_KEY=replace-me
MPESA_CONSUMER_SECRET=replace-me
MPESA_SHORTCODE=replace-me
MPESA_PASSKEY=replace-me
MPESA_CALLBACK_URL=https://your-api-domain.example/api/payments/listing/mpesa/callback/
MPESA_BASE_URL=https://sandbox.safaricom.co.ke

# PayPal
PAYPAL_CLIENT_ID=replace-me
PAYPAL_CLIENT_SECRET=replace-me
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=replace-me
PAYPAL_LISTING_WEBHOOK_ID=replace-me

# Browser redirects only. They never determine payment success.
PAYPAL_SUBSCRIPTION_RETURN_URL_LOCAL=http://localhost:5173/paypal/subscription/return
PAYPAL_SUBSCRIPTION_CANCEL_URL_LOCAL=http://localhost:5173/paypal/subscription/cancel
PAYPAL_SUBSCRIPTION_RETURN_URL_NETWORK=http://100.109.224.0:5173/paypal/subscription/return
PAYPAL_SUBSCRIPTION_CANCEL_URL_NETWORK=http://100.109.224.0:5173/paypal/subscription/cancel
PAYPAL_SUBSCRIPTION_RETURN_URL_MODE=LOCAL

# PayPal subscription webhook: /api/subscriptions/callbacks/paypal/
# PayPal individual listing payment webhook: /api/payments/callbacks/paypal/listing/
# Both webhook URLs must be publicly reachable over HTTPS and registered in the PayPal REST App.
# Their webhook IDs are stored separately in PAYPAL_WEBHOOK_ID and PAYPAL_LISTING_WEBHOOK_ID.

# Internal SakaKrib secret for payout/callback protection. This is NOT a Safaricom credential.
MPESA_PAYOUT_CALLBACK_SECRET=replace-with-random-secret
