DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,100.109.224.0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://100.109.224.0:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://100.109.224.0:5173

# Independent PostgreSQL database. These values are NOT Supabase credentials.
DB_NAME=sakakrib
DB_USER=sakakrib
DB_PASSWORD=replace-me
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=prefer
DB_CONN_MAX_AGE=60

# Channels / realtime
REDIS_URL=redis://127.0.0.1:6379/0

# Private chat attachment storage
DJANGO_MEDIA_ROOT=/absolute/path/to/media
CHAT_ATTACHMENT_BASE_URL=https://your-api-domain.example

# Django session/cookie settings
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SECURE=false

# Listing entitlement business rules
LISTING_FREE_LIMIT=3
INDIVIDUAL_LISTING_PRICE_KES=1000

# M-Pesa
MPESA_CONSUMER_KEY=replace-me
MPESA_CONSUMER_SECRET=replace-me
MPESA_SHORTCODE=replace-me
MPESA_PASSKEY=replace-me
MPESA_CALLBACK_URL=https://your-api-domain.example/api/payments/listing/mpesa/callback/
MPESA_BASE_URL=https://sandbox.safaricom.co.ke

# PayPal
PAYPAL_CLIENT_ID=replace-me
PAYPAL_CLIENT_SECRET=replace-me
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
